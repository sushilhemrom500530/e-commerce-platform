APP_NAME="PL Server"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
SERVER_PORT=8001
SERVER_HOST=0.0.0.0
API_PREFIX=api/v1
CORS_ORIGIN=
FORCE_COLOR=1
REQUEST_LOGGER_FORMAT=nestjs
REQUEST_LOGGER_COLORS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Distributed Cache & Rate Limiting - Redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@Practice Backend api.com"
MAIL_FROM_NAME="Practice Backend api"

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# JWT Configuration (Compatible with Node jsonwebtoken HS256)
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ACCESS_TOKEN_TTL=2592000
JWT_REFRESH_TOKEN_TTL=31536000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Apple Authentication Configuration
APPLE_BUNDLE_ID=
APPLE_ISSUER=https://appleid.apple.com
APPLE_KEYS_URL=https://appleid.apple.com/auth/keys

# Admin Initial Seed Credentials
ADMIN_EMAIL_ONE=admin@Practice Backend api.com
ADMIN_PASSWORD_ONE=Admin@123456
ADMIN_EMAIL_TWO=
ADMIN_PASSWORD_TWO=

# Frontend Web Client URL
CLIENT_URL=http://localhost:3000

VITE_APP_NAME="${APP_NAME}"
